{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(*.cs)",
        "hooks": [
          { "type": "command", "command": "dotnet format --include \"$CLAUDE_FILE_PATH\"", "timeout": 10000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "cd apps/web && npx tsc --noEmit && echo \"OK (TypeScript check passed)\" || echo \"OK (TypeScript errors found)\"", "timeout": 30000 }
        ]
      }
    ]
  }
}
